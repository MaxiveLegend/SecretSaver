@model CreateSecretViewModel
@{
    ViewData["Title"] = "Share a secret";
    var expiryOptions = new[]
    {
        new SelectListItem("1 hour", "1"),
        new SelectListItem("1 day", "24"),
        new SelectListItem("3 days", "72"),
        new SelectListItem("7 days", "168")
    };
}

<div class="rounded-lg border border-slate-800 bg-slate-900 p-8 shadow-lg shadow-black/30">
    <h1 class="text-2xl font-semibold text-slate-100">Share a secret</h1>
    <p class="mt-2 text-slate-400">
        Paste a password below to create a link. The secret is deleted once it has been viewed the chosen number of times, or when it expires.
    </p>

    <form asp-action="Create" method="post" class="mt-6 space-y-5">
        <div>
            <label asp-for="Secret" class="block text-sm font-medium text-slate-300"></label>
            <textarea asp-for="Secret" rows="4" autocomplete="off" spellcheck="false"
                      class="mt-1 block w-full rounded-md border border-slate-700 bg-slate-950 px-3 py-2 font-mono text-sm focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/40 focus:outline-none text-slate-100"></textarea>
            <span asp-validation-for="Secret" class="mt-1 block text-sm text-red-400"></span>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label asp-for="ExpiresInHours" class="block text-sm font-medium text-slate-300"></label>
                <select asp-for="ExpiresInHours" asp-items="expiryOptions"
                        class="mt-1 block w-full rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-sm focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/40 focus:outline-none text-slate-100"></select>
                <span asp-validation-for="ExpiresInHours" class="mt-1 block text-sm text-red-400"></span>
            </div>
            <div>
                <label asp-for="MaxViews" class="block text-sm font-medium text-slate-300"></label>
                <input asp-for="MaxViews" type="number" min="1" max="10"
                       class="mt-1 block w-full rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-sm focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/40 focus:outline-none text-slate-100" />
                <span asp-validation-for="MaxViews" class="mt-1 block text-sm text-red-400"></span>
            </div>
        </div>

        <button type="submit"
                class="w-full rounded-md bg-indigo-500 px-4 py-2.5 font-medium text-white hover:bg-indigo-400 focus:ring-2 focus:ring-indigo-400/50 focus:outline-none">
            Create link
        </button>
    </form>
</div>
