@model Guid
@{
    ViewData["Title"] = "Someone shared a secret with you";
}

<div class="rounded-lg border border-slate-800 bg-slate-900 p-8 shadow-lg shadow-black/30">
    <h1 class="text-2xl font-semibold text-slate-100">Someone shared a secret with you</h1>
    <p class="mt-2 text-slate-400">
        This link can only be opened a limited number of times. Reveal the secret when you are ready to save it.
    </p>

    <form asp-action="Reveal" asp-route-id="@Model" method="post" class="mt-6">
        <button type="submit"
                class="w-full rounded-md bg-indigo-500 px-4 py-2.5 font-medium text-white hover:bg-indigo-400 focus:ring-2 focus:ring-indigo-400/50 focus:outline-none">
            Reveal secret
        </button>
    </form>
</div>
