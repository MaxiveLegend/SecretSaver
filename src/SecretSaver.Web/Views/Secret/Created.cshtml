@model SecretCreatedViewModel
@{
    ViewData["Title"] = "Link created";
    var lifetime = Model.ExpiresInHours switch
    {
        1 => "1 hour",
        < 24 => $"{Model.ExpiresInHours} hours",
        24 => "1 day",
        _ => $"{Model.ExpiresInHours / 24} days"
    };
    var views = Model.MaxViews == 1 ? "once" : $"{Model.MaxViews} times";
}

<div class="rounded-lg border border-slate-800 bg-slate-900 p-8 shadow-lg shadow-black/30">
    <h1 class="text-2xl font-semibold text-slate-100">Your link is ready</h1>
    <p class="mt-2 text-slate-400">
        Send this link to the recipient. It can be opened <strong>@views</strong> and expires in <strong>@lifetime</strong>.
    </p>

    <div class="mt-6 flex gap-2">
        <input id="share-url" type="text" readonly value="@Model.ShareUrl"
               class="block w-full rounded-md border border-slate-700 bg-slate-950 px-3 py-2 font-mono text-sm text-slate-100" />
        <button type="button" data-copy-target="share-url"
                class="shrink-0 rounded-md bg-indigo-500 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-400">
            Copy
        </button>
    </div>

    <p class="mt-4 text-sm text-slate-400">This page is not saved: copy the link before you leave it.</p>

    <a asp-action="Create" class="mt-6 inline-block text-sm font-medium text-indigo-400 hover:text-indigo-300">Share another secret</a>
</div>
