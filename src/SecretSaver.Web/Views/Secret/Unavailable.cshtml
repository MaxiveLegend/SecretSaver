@{
    ViewData["Title"] = "Link no longer available";
}

<div class="rounded-lg border border-slate-800 bg-slate-900 p-8 shadow-lg shadow-black/30">
    <h1 class="text-2xl font-semibold text-slate-100">This link is no longer available</h1>
    <p class="mt-2 text-slate-400">
        The secret has already been viewed the maximum number of times, has expired, or never existed. Ask the sender to share it again.
    </p>

    <a asp-controller="Secret" asp-action="Create" class="mt-6 inline-block text-sm font-medium text-indigo-400 hover:text-indigo-300">Share a secret yourself</a>
</div>
