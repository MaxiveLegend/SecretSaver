@model string
@{
    ViewData["Title"] = "Your secret";
}

<div class="rounded-lg border border-slate-800 bg-slate-900 p-8 shadow-lg shadow-black/30">
    <h1 class="text-2xl font-semibold text-slate-100">Your secret</h1>
    <p class="mt-2 text-slate-400">Save it somewhere safe now. This link may no longer work after you leave this page.</p>

    <textarea id="secret-value" readonly rows="4" spellcheck="false"
              class="mt-6 block w-full rounded-md border border-slate-700 bg-slate-950 px-3 py-2 font-mono text-sm text-slate-100">@Model</textarea>

    <button type="button" data-copy-target="secret-value"
            class="mt-3 rounded-md bg-indigo-500 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-400">
        Copy
    </button>
</div>
