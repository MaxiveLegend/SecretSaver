@{
    ViewData["Title"] = "Page not found";
}

<div class="rounded-lg border border-slate-800 bg-slate-900 p-8 shadow-lg shadow-black/30">
    <h1 class="text-2xl font-semibold text-slate-100">Page not found</h1>
    <p class="mt-2 text-slate-400">This page doesn't exist. If you followed a link to a secret, check that you copied the whole link.</p>

    <a asp-controller="Secret" asp-action="Create" class="mt-6 inline-block text-sm font-medium text-indigo-400 hover:text-indigo-300">Go to the start page</a>
</div>
