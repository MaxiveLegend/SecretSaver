<!DOCTYPE html>
<html lang="en" class="scheme-dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="dark" />
    <title>@ViewData["Title"] - SecretSaver</title>
    <link rel="icon" href="~/favicon.ico" sizes="32x32" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-slate-950 text-slate-200">
    <header class="border-b border-slate-800 bg-slate-900">
        <div class="mx-auto flex max-w-2xl items-center justify-between px-6 py-4">
            <a class="text-lg font-semibold text-slate-100" asp-controller="Secret" asp-action="Create">SecretSaver</a>
            <span class="text-sm text-slate-400">Share passwords with a self-destructing link</span>
        </div>
    </header>
    <main class="mx-auto max-w-2xl px-6 py-10">
        @RenderBody()
    </main>
    <script src="~/js/copy.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
