@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="rounded-lg border border-red-900 bg-slate-900 p-8 shadow-lg shadow-black/30">
    <h1 class="text-2xl font-semibold text-red-400">Something went wrong</h1>
    <p class="mt-2 text-slate-400">An error occurred while processing your request.</p>
    @if (Model.ShowRequestId)
    {
        <p class="mt-4 text-sm text-slate-400">Request ID: <code>@Model.RequestId</code></p>
    }
</div>
