<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\SecretSaver.Application\SecretSaver.Application.csproj" />
    <ProjectReference Include="..\SecretSaver.Infrastructure\SecretSaver.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="package.json;package-lock.json" />
    <None Include="package.json" />
  </ItemGroup>

  <Target Name="NpmInstall" BeforeTargets="BuildTailwind" Condition="!Exists('node_modules')">
    <Exec Command="npm install" />
  </Target>

  <Target Name="BuildTailwind" BeforeTargets="BeforeBuild">
    <Exec Command="npm run build:css" />
    <ItemGroup>
      <Content Include="wwwroot\css\app.css" Exclude="@(Content)" />
    </ItemGroup>
  </Target>

</Project>
